diff --git a/abstract-sim-hs/config/sweeps/standard-window-adoption-confirm.json b/abstract-sim-hs/config/sweeps/standard-window-adoption-confirm.json
new file mode 100644
index 00000000..ba181765
--- /dev/null
+++ b/abstract-sim-hs/config/sweeps/standard-window-adoption-confirm.json
@@ -0,0 +1,23 @@
+{
+  "description": "Confirmation of the standard-window selection under the adoption criteria, on fresh seeds. The candidate is the exact configuration the CIP will specify: the standard controller's utilisation window taken over the 10 most recent processed-block summaries (announcements excluded), and the EB age-escape count reset at certified-EB application rather than at announcement. It is compared against the historical announcement-diluted 20-entry window with announcement-time reset, and against flat fee. Seeds 700-799 are disjoint from the screen (0-99) and from every other selection experiment. Adoption requires the enforceable configuration to match the historical behaviour and to keep the mechanism's margin over flat fee; it does not require superiority over the historical behaviour, so superiority is reported as an observation and is not gated. Pre-declared pass criteria, all of which must hold (conjunctive gating, so no multiplicity adjustment), evaluated mechanically by scripts/compare_standard_window_adoption_confirm.py: M1 candidate-minus-historical overall retained-value ratio at severe congestion, EB-capacity stress, and launch day has a 95% CI lower bound above -0.05 percentage points; M2 candidate-minus-historical trickle standard-lane retained-value ratio has a 95% CI lower bound above -1.0 percentage points; M3 candidate-minus-flat-fee overall retained value at severe congestion, EB-capacity stress, and launch day has a 95% CI above zero. Declared secondaries, reported and never gated: the launch-day candidate-minus-historical overall retained value with its 95% CI and seed-pair win count, and the low and mid-load deltas with exact-tie counts. Single attempt: the criteria were fixed before any seed in this range was run, and the outcome is reported regardless of result. Mid-load bit-identity to historical is expected and reported but not gated.",
+  "seedStart": 700,
+  "seeds": 100,
+  "slots": 2000,
+  "summaryOnly": true,
+  "randomness": "independent-streams",
+  "out": "sweep-results/standard-window-adoption-confirm/severe-congestion",
+  "variants": [
+    {
+      "name": "historical",
+      "config": "config/variants/standard-target-screen/s75-u50.json"
+    },
+    {
+      "name": "flat-fee",
+      "config": "config/variants/flat-fee.json"
+    },
+    {
+      "name": "block-window-10-cert-reset",
+      "config": "config/variants/standard-window-confirm/block-window-10-cert-reset.json"
+    }
+  ]
+}
diff --git a/abstract-sim-hs/config/sweeps/standard-window-screen.json b/abstract-sim-hs/config/sweeps/standard-window-screen.json
new file mode 100644
index 00000000..f5d7ef57
--- /dev/null
+++ b/abstract-sim-hs/config/sweeps/standard-window-screen.json
@@ -0,0 +1,35 @@
+{
+  "description": "Exploratory screen of the standard controller's window length under the enforceable processed-block window semantics. The announcement-semantics smoke showed that the historical signal's zero-width EbAnnounced entries shorten the effective window at contended loads (to roughly 10-13 processed blocks), and that a clean 20-processed-block window loses launch-day retained value against it. Announcement entries are not adoptable in the ledger rule: an announcement is a costless, unpunishable producer claim, so counting it would hand producers a free lever on the standard quote. This screen therefore asks whether a shorter processed-block window recovers the historical performance. Arms: the historical announcement-diluted 20-entry window (reference), flat fee (baseline), and processed-block windows of 10, 13, 15, and 20. Everything else is fixed at S=.75/U=.50, D16, half-RB threshold, K10, announcement-time age reset. One hundred paired seeds across the five headline loads plus the 0.1 tx/slot trickle. This is a screen: any selected length needs confirmation on disjoint seeds before adoption.",
+  "seedStart": 0,
+  "seeds": 100,
+  "slots": 2000,
+  "summaryOnly": true,
+  "randomness": "independent-streams",
+  "out": "sweep-results/standard-window-screen/severe-congestion",
+  "variants": [
+    {
+      "name": "historical",
+      "config": "config/variants/standard-target-screen/s75-u50.json"
+    },
+    {
+      "name": "flat-fee",
+      "config": "config/variants/flat-fee.json"
+    },
+    {
+      "name": "block-window-10",
+      "config": "config/variants/standard-window-screen/block-window-10.json"
+    },
+    {
+      "name": "block-window-13",
+      "config": "config/variants/standard-window-screen/block-window-13.json"
+    },
+    {
+      "name": "block-window-15",
+      "config": "config/variants/standard-window-screen/block-window-15.json"
+    },
+    {
+      "name": "block-window-20",
+      "config": "config/variants/standard-window-screen/block-window-20.json"
+    }
+  ]
+}
