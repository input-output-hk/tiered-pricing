@@ -0,0 +1,151 @@
+#!/usr/bin/env bash
+
+set -euo pipefail
+
+script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
+project_dir="$(cd -- "$script_dir/.." && pwd)"
+manifest="config/sweeps/announcement-semantics-smoke.json"
+out_dir="sweep-results/announcement-semantics-smoke"
+seed_start=440
+seeds=10
+slots=2000
+
+usage() {
+  cat <<'EOF'
+usage: ./scripts/run_announcement_semantics_smoke.sh [--out DIR] [--seed-start N] [--seeds N] [--slots N]
+
+Run a paired four-arm ablation of the simulator's announcement semantics
+against the CIP's specified semantics:
+
+  historical               announcements occupy standard-window positions;
+                           age-escape count resets at every announcement
+  block-window             the standard controller's 20-entry window is taken
+                           over processed-block summaries only (EbAnnounced
+                           entries filtered out before the window is cut)
+  cert-reset               the age-escape count resets only when a certified
+                           EB is applied, not at announcement
+  block-window-cert-reset  both changes together
+
+Everything else remains fixed at S=.75/U=.50, D16, half-RB threshold, K10.
+
+The default run uses ten paired seeds, 2,000 slots, independent RNG streams,
+the five headline loads, and the 0.1 tx/slot trickle load (where the age
+escape binds). It is sized as a directional smoke test on the development
+machine; it is not confirmatory evidence.
+
+The output directory is reserved before execution and is never overwritten.
+EOF
+}
+
+positive_integer() {
+  [[ "$1" =~ ^[1-9][0-9]*$ ]]
+}
+
+non_negative_integer() {
+  [[ "$1" =~ ^[0-9]+$ ]]
+}
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    -h|--help)
+      usage
+      exit 0
+      ;;
+    --out)
+      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
+      [[ -n "$2" ]] || { echo "error: --out must not be empty" >&2; exit 2; }
+      out_dir="$2"
+      shift 2
+      ;;
+    --seed-start)
+      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
+      non_negative_integer "$2" || { echo "error: --seed-start needs a non-negative integer" >&2; exit 2; }
+      seed_start="$2"
+      shift 2
+      ;;
+    --seeds)
+      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
+      positive_integer "$2" || { echo "error: --seeds needs a positive integer" >&2; exit 2; }
+      seeds="$2"
+      shift 2
+      ;;
+    --slots)
+      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
+      positive_integer "$2" || { echo "error: --slots needs a positive integer" >&2; exit 2; }
+      slots="$2"
+      shift 2
+      ;;
+    *)
+      usage >&2
+      exit 2
+      ;;
+  esac
+done
+
+if (( seeds < 2 )); then
+  echo "error: --seeds must be at least 2 for paired intervals" >&2
+  exit 2
+fi
+
+cd "$project_dir"
+
